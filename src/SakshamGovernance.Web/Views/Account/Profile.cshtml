@model ApplicationUser
@{
    ViewData["Title"] = "My account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sadachar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/accessed.css" />
</head>
<body>
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-7 col-lg-5">
                <section class="accessed-card" aria-labelledby="profile-heading">
                    <h1 id="profile-heading" class="h2">Signed in successfully</h1>
                    <dl>
                        <dt>Name</dt>
                        <dd>@Model.FullName</dd>
                        <dt>Email</dt>
                        <dd>@Model.Email</dd>
                        <dt>Access level</dt>
                        <dd>@Model.Role</dd>
                        <dt>Account ID</dt>
                        <dd><code>@Model.Id</code></dd>
                    </dl>
                    <a href="/" class="btn-accessed-primary">Open Sadachar portal</a>
                    <form asp-action="Logout" method="post" class="mt-3">
                        <button type="submit" class="btn-accessed-secondary">Sign out</button>
                    </form>
                </section>
            </div>
        </div>
    </main>
</body>
</html>
