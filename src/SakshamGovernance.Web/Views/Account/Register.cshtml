@model StudentRegistrationViewModel
@{
    ViewData["Title"] = "Create student account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sadachar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/accessed.css" />
</head>
<body>
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-7 col-lg-5">
                <a asp-action="Login" class="text-decoration-none">← Back to sign in</a>
                <section class="accessed-card mt-3" aria-labelledby="register-heading">
                    <h1 id="register-heading" class="h2">Create a student account</h1>
                    <p class="text-muted">Your account is stored in the application's configured database.</p>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="accessed-input" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="accessed-input" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="accessed-input" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="form-text">Use at least 8 characters and include a number.</small>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="accessed-input" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn-accessed-primary w-100">Create account</button>
                    </form>
                    <p class="small text-muted mt-3 mb-0">New accounts receive student access. Educator access must be assigned by an administrator.</p>
                </section>
            </div>
        </div>
    </main>
</body>
</html>
