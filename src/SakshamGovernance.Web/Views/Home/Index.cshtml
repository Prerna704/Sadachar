@{
    ViewData["Title"] = "ASP.NET Core MVC";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sadachar</title>
    <style>
        body { font-family: system-ui, sans-serif; line-height: 1.6; margin: 0 auto; max-width: 860px; padding: 2rem; color: #17324d; }
        a { color: #075e9b; }
        .card { border: 1px solid #c8d6e2; border-radius: .75rem; margin: 1rem 0; padding: 1rem 1.25rem; }
        nav { display: flex; flex-wrap: wrap; gap: 1rem; }
    </style>
</head>
<body>
    <main>
        <h1>Sadachar — ASP.NET Core MVC</h1>
        <p>This Razor view is rendered by <code>HomeController</code> using the conventional MVC route.</p>

        <section class="card" aria-labelledby="stack-heading">
            <h2 id="stack-heading">Project technology stack</h2>
            <ul>
                <li>C# 14 and .NET 10</li>
                <li>ASP.NET Core MVC controllers and Razor views</li>
                <li>ASP.NET Core Web API controllers</li>
                <li>Entity Framework Core 10 with SQL Server support</li>
                <li>Dependency injection for repositories and services</li>
            </ul>
        </section>

        <nav aria-label="Project links">
            <a href="/">Accessible portal</a>
            <a href="/swagger">Web API documentation</a>
            <a href="/api/governance/grievances">Grievances API</a>
        </nav>
    </main>
</body>
</html>
