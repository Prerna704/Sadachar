@model (string Title, string Description, string Meta, string Icon, string Url)

<div class="retro-list-item d-flex align-items-center justify-content-between p-3 mb-2" style="background: var(--paper-card); border: 3px solid var(--ink); border-radius: 14px; box-shadow: 3px 3px 0 var(--ink);">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(Model.Icon))
        {
            <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border: 2.5px solid var(--ink); border-radius: 12px; background: var(--mustard); box-shadow: 2px 2px 0 var(--ink);">
                <i class="bi @Model.Icon fs-5" aria-hidden="true"></i>
            </div>
        }
        <div>
            <div class="fw-bold" style="color: var(--ink); font-size: 0.95rem;">@Model.Title</div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="text-muted" style="font-size: 0.85rem;">@Model.Description</div>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(Model.Meta))
        {
            <span class="pill-chip pill-chip-sage" style="font-size: 0.75rem;">@Model.Meta</span>
        }
        @if (!string.IsNullOrEmpty(Model.Url))
        {
            <a href="@Model.Url" class="btn-retro-secondary px-3 py-1" style="font-size: 0.82rem; min-height: 38px;">
                Open <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        }
    </div>
</div>
