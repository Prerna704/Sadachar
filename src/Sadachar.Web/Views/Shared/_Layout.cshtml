<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — AccessEd" : "AccessEd — Education for Every Learner")</title>

    <!-- Google Fonts: Playfair Display 900, Yellowtail, DM Sans 16/26, Lexend -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400;1,9..40,700&family=Lexend:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,900;1,900&family=Yellowtail&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- AccessEd Retro Fuzzy Stylesheet -->
    <link rel="stylesheet" href="/css/accessed.css?v=2.0" />
    <link rel="stylesheet" href="/css/site.css?v=3.0" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="theme-paper">
    <!-- Accessible Skip Link (WCAG 2.2 AA) -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <!-- ARIA Live Announcer -->
    <div id="screen-announcer" class="visually-hidden" aria-live="polite"></div>

    <!-- Public Header & Landmark Navigation -->
    <header class="public-header" role="banner" style="background: var(--paper-card); border-bottom: 3px solid var(--ink); box-shadow: 0 4px 0 var(--ink);">
        <div class="container-xl d-flex align-items-center justify-content-between py-3">
            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none" style="color: var(--ink);">
                <span class="d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; background: var(--rust); color: #FAF4EA; border: 3px solid var(--ink); border-radius: 12px; box-shadow: 3px 3px 0 var(--ink); font-family: var(--font-heading); font-size: 1.4rem;">A</span>
                <div>
                    <span class="fs-4 fw-black font-headline" style="letter-spacing: -0.5px;">Access<span class="retro-accent">Ed</span></span>
                    <span class="d-none d-sm-block text-muted" style="font-size: 0.75rem; font-weight: 500; line-height: 1;">Education for every learner</span>
                </div>
            </a>

            <!-- Public Nav Links -->
            <nav class="d-none d-md-flex align-items-center gap-4" role="navigation" aria-label="Main Navigation">
                <a href="/#features" class="fw-bold text-decoration-none" style="color: var(--ink);">Features</a>
                <a href="/#compliance" class="fw-bold text-decoration-none" style="color: var(--ink);">Compliance</a>
                <a href="/#institutions" class="fw-bold text-decoration-none" style="color: var(--ink);">Institutions</a>
                <a asp-controller="Resources" asp-action="Index" class="fw-bold text-decoration-none" style="color: var(--ink);">Library</a>
            </nav>

            <!-- Authentication Actions -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-retro-secondary py-1 px-3" style="font-size: 0.9rem;">
                        <i class="bi bi-grid-fill" aria-hidden="true"></i> Dashboard
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-retro-secondary py-1 px-2" style="font-size: 0.85rem;" title="Sign out" aria-label="Sign out">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-retro-secondary py-2 px-3" style="font-size: 0.9rem;">Sign in</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-retro-primary py-2 px-3" style="font-size: 0.9rem;">Get started</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Landmark -->
    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <!-- Public Footer Landmark -->
    <footer class="public-footer mt-5 py-5" role="contentinfo" style="background: var(--paper-card); border-top: 3px solid var(--ink);">
        <div class="container-xl">
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fw-black fs-4 font-headline" style="color: var(--ink);">AccessEd</span>
                        <span class="pill-chip pill-chip-teal ms-2">WCAG 2.2 Level AA</span>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.92rem; max-width: 480px;">
                        Education that adapts to every learner. Built with semantic HTML, multi-format accessibility tools, and transparent compliance governance.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex flex-wrap justify-content-md-end gap-3 mb-2">
                        <a href="/swagger" class="fw-bold text-decoration-none" style="color: var(--ink);">Web API / Swagger</a>
                        <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--ink);">Sign in</a>
                        <a asp-controller="Support" asp-action="Index" class="fw-bold text-decoration-none" style="color: var(--ink);">Report Barrier</a>
                    </div>
                    <small class="text-muted d-block" style="font-size: 0.8rem;">
                        &copy; @DateTime.UtcNow.Year AccessEd Ecosystem. Designed for accessibility, compliance and proper conduct.
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js?v=3.0"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
