@model Sadachar.Web.ViewModels.MaterialDetailsViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = Model.Material.Title;
}

<!-- Breadcrumbs & Title -->
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb" style="font-size: 0.88rem;">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none fw-bold" style="color: var(--rust);">Resources</a></li>
        <li class="breadcrumb-item active fw-semibold" aria-current="page">@Model.Material.Module</li>
    </ol>
</nav>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-black mb-1 font-headline">@Model.Material.Title</h1>
        <span class="pill-chip pill-chip-teal"><i class="bi bi-shield-check"></i> @Model.Material.AccessibilityScore% WCAG 2.2 AA Verified</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Reader" asp-route-id="@Model.Material.MaterialId" class="btn-retro-primary text-decoration-none">
            <i class="bi bi-headphones" aria-hidden="true"></i> Open in TTS Reader
        </a>
    </div>
</div>

<!-- Format Switcher Segmented Tabs -->
<div class="d-flex flex-wrap gap-2 mb-4" role="tablist" aria-label="Material format switcher">
    @foreach (var fmt in new[] { "Text", "Audio", "Captioned video", "Braille-ready", "Easy-read" })
    {
        var isActive = string.Equals(Model.ActiveFormat, fmt, StringComparison.OrdinalIgnoreCase);
        <a asp-action="Details" asp-route-id="@Model.Material.MaterialId" asp-route-format="@fmt"
           class="pill-chip @(isActive ? "pill-chip-mustard" : "pill-chip-sage") text-decoration-none" role="tab" aria-selected="@(isActive ? "true" : "false")" style="padding: 6px 16px;">
            @fmt
        </a>
    }
</div>

<div class="row g-4">
    <!-- Main Content & Media Area -->
    <div class="col-lg-8">
        <div class="retro-card mb-4" style="background: var(--paper-card);">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 3px solid var(--ink);">
                <h2 class="h5 fw-black mb-0 font-headline">
                    @(Model.ActiveFormat == "Audio" ? "Audio narration" : Model.ActiveFormat == "Captioned video" ? "Captioned recording" : "Lesson text")
                </h2>
                <span class="text-muted fw-bold" style="font-size: 0.85rem;"><i class="bi bi-clock me-1"></i> @Model.Material.EstimatedMinutes min read</span>
            </div>

            <!-- Content Area -->
            <div class="lesson-content mb-4" style="font-size: 1.05rem; line-height: 1.8;">
                <p>@Model.Material.ContentText</p>
            </div>

            <!-- Inline Audio Player Bar Partial -->
            @await Html.PartialAsync("_AudioPlayer", (Model.Material.Title, "#", "03:45"))
        </div>
    </div>

    <!-- Right Side: Accessibility Checks & Downloads -->
    <div class="col-lg-4">
        <!-- Accessibility Checks Checklist -->
        <div class="retro-card mb-4" style="background: var(--paper-card);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 fw-black mb-0 font-headline">Accessibility checks</h2>
                <div style="width: 32px; height: 32px;">
                    @await Html.PartialAsync("_Avatar", "Brailly")
                </div>
            </div>
            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5" aria-hidden="true"></i>
                    <span class="fw-bold" style="font-size: 0.95rem;">Alt text on illustrations</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5" aria-hidden="true"></i>
                    <span class="fw-bold" style="font-size: 0.95rem;">Captions & synchronized transcript</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5" aria-hidden="true"></i>
                    <span class="fw-bold" style="font-size: 0.95rem;">Logical reading order</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5" aria-hidden="true"></i>
                    <span class="fw-bold" style="font-size: 0.95rem;">Contrast ratio 7:1 (AAA)</span>
                </li>
            </ul>
        </div>

        <!-- Download Formats Box -->
        <div class="retro-card" style="background: var(--paper-card);">
            <h2 class="h5 fw-black mb-3 font-headline">Download formats</h2>
            <div class="d-flex flex-column gap-2">
                @foreach (var fmt in Model.Material.Formats)
                {
                    <a href="@(!string.IsNullOrEmpty(fmt.FilePath) ? fmt.FilePath : "#")" class="btn-retro-secondary d-flex align-items-center justify-content-between py-2 px-3 text-decoration-none" download>
                        <span class="fw-bold"><i class="bi bi-download me-2"></i> @fmt.FormatType</span>
                        <span class="pill-chip pill-chip-sage py-0 px-2" style="font-size: 0.72rem;">@fmt.DurationMinutes min</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
