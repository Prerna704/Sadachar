@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}
<script>window.location.href = "/Account/Login?tab=register";</script>
<div class="container py-5 text-center">
    <div class="retro-card p-5 mx-auto" style="max-width: 480px;">
        <div class="brush-blob brush-blob-mustard mb-3" style="width: 80px; height: 80px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
            <div style="width: 60px; height: 60px;">
                @await Html.PartialAsync("_Avatar", "Dot")
            </div>
        </div>
        <h2 class="font-headline fs-3 fw-black mb-2">Joining AccessEd</h2>
        <p class="text-muted mb-4">Redirecting to registration portal...</p>
        <a href="/Account/Login?tab=register" class="btn-retro-primary">Open Registration</a>
    </div>
</div>
