@model Sadachar.Web.ViewModels.UserProfileEditViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Profile and Settings";
    var defaultAvatar = Model.Role.ToLower().Contains("teacher") ? "Pip" : Model.Role.ToLower().Contains("admin") ? "Lumo" : "Echo";
}

<div class="mb-4">
    <h1 class="h2 fw-black mb-1 font-headline">Profile & <span class="retro-accent">settings</span></h1>
    <p class="text-muted mb-0 fw-semibold" style="font-size: 1rem;">Manage your learner identity, companion avatar, and privacy consents</p>
</div>

<div class="row g-4">
    <!-- Left Column: User Summary Card & Companion Avatar -->
    <div class="col-lg-4">
        <div class="retro-card text-center p-4 mb-4" style="background: var(--paper-card);">
            <!-- Active Avatar with painted brush blob -->
            <div class="brush-blob brush-blob-mustard mx-auto mb-3" style="width: 90px; height: 90px; display: flex; align-items: center; justify-content: center;">
                <div style="width: 72px; height: 72px;">
                    @await Html.PartialAsync("_Avatar", defaultAvatar)
                </div>
            </div>

            <h2 class="h4 fw-black mb-1 font-headline">@Model.FullName</h2>
            <p class="text-muted fw-semibold mb-3" style="font-size: 0.9rem;">@Model.Role · @Model.Department</p>

            <span class="pill-chip pill-chip-teal py-1 px-3 mb-3">
                <i class="bi bi-person-check-fill me-1" aria-hidden="true"></i> @Model.AccessibilityNeed
            </span>

            <div class="p-3 text-start mt-3" style="background: var(--paper); border: 2.5px solid var(--ink); border-radius: 12px; box-shadow: 3px 3px 0 var(--ink);">
                <small class="text-muted d-block fw-bold mb-1 font-headline" style="font-size: 0.72rem;">ACCOUNT ROLE</small>
                <span class="d-block mb-2 fw-bold" style="font-size: 0.88rem;">@Model.Role workspace</span>

                <small class="text-muted d-block fw-bold mb-1 font-headline" style="font-size: 0.72rem;">REGISTERED IDENTITY</small>
                <span class="d-block fw-bold text-truncate" style="font-size: 0.88rem;">@Model.Email</span>
            </div>
        </div>

        <!-- Avatar Selection Gallery Card -->
        <div class="retro-card mb-4" style="background: var(--paper-card);">
            <h2 class="h6 fw-black mb-2 font-headline">Access Companion</h2>
            <p class="text-muted fw-semibold mb-3" style="font-size: 0.82rem;">
                Select your furry guide mascot for dashboards and accessible reminders:
            </p>
            <div class="d-flex justify-content-between align-items-center p-2" style="background: var(--paper); border: 2px solid var(--ink); border-radius: 12px;">
                <div class="text-center" title="Lumo (Low Vision)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Lumo")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Lumo</small>
                </div>
                <div class="text-center" title="Roly (Wheelchair)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Roly")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Roly</small>
                </div>
                <div class="text-center" title="Echo (Deaf/HOH)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Echo")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Echo</small>
                </div>
                <div class="text-center" title="Dot (Dyslexia)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Dot")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Dot</small>
                </div>
                <div class="text-center" title="Brailly (Blind)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Brailly")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Brailly</small>
                </div>
                <div class="text-center" title="Pip (Teacher)">
                    <div style="width: 38px; height: 38px; margin: 0 auto;">@await Html.PartialAsync("_Avatar", "Pip")</div>
                    <small class="d-block fw-bold" style="font-size: 0.68rem;">Pip</small>
                </div>
            </div>
        </div>

        <div class="retro-card" style="background: var(--paper-card);">
            <h2 class="h6 fw-black mb-2 font-headline"><i class="bi bi-universal-access me-1 text-primary"></i> Assistive Settings</h2>
            <p class="text-muted fw-semibold mb-3" style="font-size: 0.82rem;">
                Adjust typography, line spacing, TTS voice speed, and high-contrast color themes.
            </p>
            <a asp-controller="Accessibility" asp-action="Index" class="btn-retro-secondary w-100 text-center text-decoration-none py-2" style="font-size: 0.85rem;">
                Accessibility controls &rarr;
            </a>
        </div>
    </div>

    <!-- Right Column: Personal Details & Privacy Toggles -->
    <div class="col-lg-8">
        <div class="retro-card mb-4" style="background: var(--paper-card);">
            <h2 class="h5 fw-black mb-4 pb-2 font-headline" style="border-bottom: 3px solid var(--ink);">
                Personal details
            </h2>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold">Full name</label>
                    <input asp-for="FullName" class="accessed-input" required />
                    <span asp-validation-for="FullName" class="text-danger fw-bold" style="font-size: 0.82rem;"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input value="@Model.Email" class="accessed-input text-muted" readonly disabled style="opacity: 0.85;" />
                    <small class="text-muted fw-semibold">Email address is managed by institutional identity administration.</small>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Department" class="form-label fw-bold">Department / Course</label>
                        <input asp-for="Department" class="accessed-input" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="AccessibilityNeed" class="form-label fw-bold">Accessibility need</label>
                        <select asp-for="AccessibilityNeed" class="accessed-select">
                            <option value="Low vision">Low vision (Lumo)</option>
                            <option value="Blind / Screen reader">Blind / Screen reader (Brailly)</option>
                            <option value="Hard of hearing / Deaf">Hard of hearing / Deaf (Echo)</option>
                            <option value="Motor / Physical barrier">Motor / Physical barrier (Roly)</option>
                            <option value="Dyslexia / Cognitive">Dyslexia / Cognitive (Dot)</option>
                            <option value="None">None</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn-retro-primary py-2 px-4">
                    Save changes
                </button>
            </form>
        </div>

        <!-- Notifications and Privacy -->
        <div class="retro-card" style="background: var(--paper-card);">
            <h2 class="h5 fw-black mb-4 pb-2 font-headline" style="border-bottom: 3px solid var(--ink);">
                Notifications & privacy
            </h2>

            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between p-2" style="background: var(--paper); border: 2.5px solid var(--ink); border-radius: 12px;">
                    <div>
                        <span class="fw-bold d-block font-headline">Email me when tickets update</span>
                        <small class="text-muted fw-semibold">Receive status updates whenever staff respond to your reported barriers</small>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input type="checkbox" class="form-check-input" checked style="cursor: pointer; accent-color: var(--rust);" />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between p-2" style="background: var(--paper); border: 2.5px solid var(--ink); border-radius: 12px;">
                    <div>
                        <span class="fw-bold d-block font-headline">Share needs with my teachers</span>
                        <small class="text-muted fw-semibold">Allows faculty to automatically see your format accommodation needs (DPDP Consent Rule)</small>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input type="checkbox" class="form-check-input" checked style="cursor: pointer; accent-color: var(--rust);" />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between p-2" style="background: var(--paper); border: 2.5px solid var(--ink); border-radius: 12px;">
                    <div>
                        <span class="fw-bold d-block font-headline">Two-step verification</span>
                        <small class="text-muted fw-semibold">Secure your account with multi-factor authentication (MFA)</small>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input type="checkbox" class="form-check-input" style="cursor: pointer; accent-color: var(--rust);" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
