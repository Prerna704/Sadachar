@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sadachar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/accessed.css" />
</head>
<body>
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-7 col-lg-5">
                <a class="text-decoration-none" href="/">← Sadachar home</a>
                <section class="accessed-card mt-3" aria-labelledby="login-heading">
                    <h1 id="login-heading" class="h2">Welcome back</h1>
                    <p class="text-muted">Sign in to your Sadachar account.</p>

                    <form asp-action="Login" method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <fieldset class="mb-3">
                            <legend class="fs-6 fw-semibold">Level of access</legend>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input asp-for="Role" class="form-check-input" type="radio" value="@UserRole.Student" id="role-student" />
                                    <label class="form-check-label" for="role-student">Student</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Role" class="form-check-input" type="radio" value="@UserRole.Educator" id="role-educator" />
                                    <label class="form-check-label" for="role-educator">Teacher / Educator</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Role" class="form-check-input" type="radio" value="@UserRole.Admin" id="role-admin" />
                                    <label class="form-check-label" for="role-admin">Administrator</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Role" class="form-check-input" type="radio" value="@UserRole.Auditor" id="role-auditor" />
                                    <label class="form-check-label" for="role-auditor">Auditor</label>
                                </div>
                            </div>
                        </fieldset>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="accessed-input" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="accessed-input" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn-accessed-primary w-100">Sign in</button>
                    </form>

                    <p class="mt-4 mb-0 text-center">
                        New student? <a asp-action="Register">Create a student account</a>
                    </p>
                    <p class="small text-muted mt-3 mb-0">
                        Educator accounts are created by the institution administrator. Choosing Educator here does not grant educator access.
                    </p>
                </section>
            </div>
        </div>
    </main>
</body>
</html>
