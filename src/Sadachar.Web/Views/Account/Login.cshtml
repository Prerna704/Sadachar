@model Sadachar.Web.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In & Register";
    var activeTab = (string?)ViewBag.ActiveTab ?? "login";
    var regModel = (Sadachar.Web.ViewModels.StudentRegistrationViewModel?)ViewBag.RegisterModel ?? new Sadachar.Web.ViewModels.StudentRegistrationViewModel();
}

<div class="container-xl py-5">
    <div class="row g-5 align-items-center justify-content-center">
        <!-- Left Side: Welcome & Assistive Preview Controls -->
        <div class="col-lg-5">
            <span class="pill-chip pill-chip-teal mb-3"><i class="bi bi-person-badge" aria-hidden="true"></i> Personal Workspace</span>
            <h1 class="display-6 fw-black mb-3 font-headline" style="color: var(--ink);">
                Welcome back to a learning space that <span class="retro-accent">fits</span> you.
            </h1>
            <p class="lead mb-4" style="color: var(--muted); font-size: 1.05rem; line-height: 1.625;">
                Sign in to continue with your saved accessibility profile, customized contrast, fonts, and assistive speech tools.
            </p>

            <!-- Preview Settings Box Before Login -->
            <div class="retro-card p-4 mb-4" style="background: var(--paper-card);">
                <div class="fw-bold mb-3 d-flex align-items-center gap-2 font-headline fs-5">
                    <i class="bi bi-eye" aria-hidden="true"></i> Preview settings before you sign in
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-bold d-block">High-contrast mode</span>
                            <small class="text-muted">Pure black & gold palette for low vision</small>
                        </div>
                        <button type="button" class="btn-retro-secondary py-1 px-3" id="btn-toggle-contrast" onclick="toggleContrastMode()" style="font-size: 0.85rem;">
                            Toggle
                        </button>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-bold d-block">Large text</span>
                            <small class="text-muted">Scale font size up by 125%</small>
                        </div>
                        <button type="button" class="btn-retro-secondary py-1 px-3" id="btn-toggle-large-text" onclick="toggleLargeText()" style="font-size: 0.85rem;">
                            Toggle
                        </button>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-bold d-block">Read aloud sample</span>
                            <small class="text-muted">Test browser speech synthesis</small>
                        </div>
                        <button type="button" class="btn-retro-secondary py-1 px-3" onclick="testReadAloud()" style="font-size: 0.85rem;">
                            <i class="bi bi-volume-up" aria-hidden="true"></i> Play
                        </button>
                    </div>
                </div>
            </div>

            <!-- Pre-seeded accounts quick fill with Avatars -->
            <div class="p-3" style="background: var(--paper-card); border: 3px solid var(--ink); border-radius: 16px; box-shadow: 4px 4px 0 var(--ink);">
                <strong class="d-block mb-2 font-headline" style="font-size: 0.92rem;"><i class="bi bi-key-fill text-warning"></i> Demo Accounts (Password: <code>Access@123</code>):</strong>
                <div class="d-flex flex-wrap gap-2 pt-1">
                    <button type="button" class="btn-retro-secondary py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.82rem;" onclick="fillLogin('student@accessed.local')">
                        <span style="width: 20px; height: 20px; display: inline-block;">@await Html.PartialAsync("_Avatar", "Echo")</span>
                        Student
                    </button>
                    <button type="button" class="btn-retro-secondary py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.82rem;" onclick="fillLogin('teacher@accessed.local')">
                        <span style="width: 20px; height: 20px; display: inline-block;">@await Html.PartialAsync("_Avatar", "Pip")</span>
                        Teacher
                    </button>
                    <button type="button" class="btn-retro-secondary py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.82rem;" onclick="fillLogin('admin@accessed.local')">
                        <span style="width: 20px; height: 20px; display: inline-block;">@await Html.PartialAsync("_Avatar", "Lumo")</span>
                        Admin
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Side: Tabbed Sign In / Register Form -->
        <div class="col-lg-6 col-xl-5">
            <div class="retro-card p-4" style="background: var(--paper-card);">
                <!-- Segmented Tabs -->
                <ul class="nav nav-pills nav-fill mb-4 p-1" style="background: var(--paper); border: 3px solid var(--ink); border-radius: 14px;" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "login" ? "active" : "") fw-bold" id="login-tab" data-bs-toggle="pill" data-bs-target="#tab-pane-login" type="button" role="tab" aria-controls="tab-pane-login" aria-selected="@(activeTab == "login" ? "true" : "false")" style="border-radius: 10px; color: var(--ink);">
                            Sign in
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "register" ? "active" : "") fw-bold" id="register-tab" data-bs-toggle="pill" data-bs-target="#tab-pane-register" type="button" role="tab" aria-controls="tab-pane-register" aria-selected="@(activeTab == "register" ? "true" : "false")" style="border-radius: 10px; color: var(--ink);">
                            Register
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabContent">
                    <!-- Tab Pane: Sign In -->
                    <div class="tab-pane fade @(activeTab == "login" ? "show active" : "")" id="tab-pane-login" role="tabpanel" aria-labelledby="login-tab">
                        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="border: 3px solid var(--ink); border-radius: 10px; font-size: 0.88rem;" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email address</label>
                                <input asp-for="Email" id="login-email-input" class="accessed-input" placeholder="student@accessed.local" autocomplete="email" required />
                                <span asp-validation-for="Email" class="text-danger fw-bold" style="font-size: 0.85rem;"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <label asp-for="Password" class="form-label fw-bold">Password</label>
                                    <a asp-action="ForgotPassword" class="text-decoration-none fw-bold" style="font-size: 0.85rem; color: var(--rust);">Forgot password?</a>
                                </div>
                                <input asp-for="Password" id="login-password-input" class="accessed-input" placeholder="••••••••" autocomplete="current-password" required />
                                <span asp-validation-for="Password" class="text-danger fw-bold" style="font-size: 0.85rem;"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input asp-for="RememberMe" class="form-check-input" style="border: 2px solid var(--ink);" />
                                <label asp-for="RememberMe" class="form-check-label fw-bold" style="font-size: 0.9rem;">Remember me</label>
                            </div>

                            <button type="submit" class="btn-retro-primary w-100 py-2">
                                Sign in <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Tab Pane: Register -->
                    <div class="tab-pane fade @(activeTab == "register" ? "show active" : "")" id="tab-pane-register" role="tabpanel" aria-labelledby="register-tab">
                        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="reg-fullname" class="form-label fw-bold">Full name</label>
                                <input id="reg-fullname" name="FullName" value="@regModel.FullName" class="accessed-input" placeholder="Aarav Sharma" required />
                            </div>

                            <div class="mb-3">
                                <label for="reg-email" class="form-label fw-bold">Email address</label>
                                <input id="reg-email" name="Email" type="email" value="@regModel.Email" class="accessed-input" placeholder="aarav.sharma@college.edu" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-sm-6">
                                    <label for="reg-pwd" class="form-label fw-bold">Password</label>
                                    <input id="reg-pwd" name="Password" type="password" class="accessed-input" placeholder="At least 8 chars" required />
                                </div>
                                <div class="col-sm-6">
                                    <label for="reg-confirm" class="form-label fw-bold">Confirm password</label>
                                    <input id="reg-confirm" name="ConfirmPassword" type="password" class="accessed-input" placeholder="Repeat password" required />
                                </div>
                            </div>

                            <!-- Role Selector (Student or Teacher) with Avatar preview -->
                            <div class="mb-3">
                                <label class="form-label fw-bold d-block">Register as</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check d-flex align-items-center gap-1">
                                        <input class="form-check-input" type="radio" name="Role" id="role-student" value="1" checked style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold d-flex align-items-center gap-1" for="role-student">
                                            <span style="width: 22px; height: 22px; display: inline-block;">@await Html.PartialAsync("_Avatar", "Echo")</span>
                                            Student
                                        </label>
                                    </div>
                                    <div class="form-check d-flex align-items-center gap-1">
                                        <input class="form-check-input" type="radio" name="Role" id="role-teacher" value="2" style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold d-flex align-items-center gap-1" for="role-teacher">
                                            <span style="width: 22px; height: 22px; display: inline-block;">@await Html.PartialAsync("_Avatar", "Pip")</span>
                                            Teacher
                                        </label>
                                    </div>
                                    <div class="form-check text-muted" title="Admin registration is not public">
                                        <input class="form-check-input" type="radio" id="role-admin" disabled style="border: 2px solid #ccc;">
                                        <label class="form-check-label" for="role-admin">Admin</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Accessibility Needs (Optional) -->
                            <div class="mb-4">
                                <label class="form-label fw-bold d-block mb-1">Accessibility guide match (optional)</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="AccessibilityNeeds" value="Visual" id="need-visual" style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold" for="need-visual">Visual (Lumo)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="AccessibilityNeeds" value="Hearing" id="need-hearing" style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold" for="need-hearing">Hearing (Echo)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="AccessibilityNeeds" value="Motor" id="need-motor" style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold" for="need-motor">Mobility (Roly)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="AccessibilityNeeds" value="Learning" id="need-learning" style="border: 2px solid var(--ink);">
                                        <label class="form-check-label fw-bold" for="need-learning">Dyslexic (Dot)</label>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn-retro-primary w-100 py-2">
                                Create account <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(email) {
            document.getElementById('login-email-input').value = email;
            document.getElementById('login-password-input').value = 'Access@123';
            const tabBtn = document.getElementById('login-tab');
            if (tabBtn) {
                const tab = new bootstrap.Tab(tabBtn);
                tab.show();
            }
        }

        function toggleContrastMode() {
            document.body.classList.toggle('theme-high-contrast');
            const isHigh = document.body.classList.contains('theme-high-contrast');
            localStorage.setItem('accessed_theme', isHigh ? 'high-contrast' : 'paper');
        }

        function toggleLargeText() {
            if (document.documentElement.style.fontSize === '20px') {
                document.documentElement.style.fontSize = '16px';
            } else {
                document.documentElement.style.fontSize = '20px';
            }
        }

        function testReadAloud() {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance("Welcome to AccessEd. Accessibility is active.");
                utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
            } else {
                alert("Web Speech API is not supported in this browser.");
            }
        }
    </script>
}
