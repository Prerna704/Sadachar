@{
    ViewData["Title"] = "Password help";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Sadachar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="auth-page">
    <a class="skip-link" href="#help-heading">Skip to password help</a>
    <main class="auth-shell auth-help-shell">
        <section class="welcome-panel" aria-labelledby="welcome-title">
            <a class="brand" href="/" aria-label="Sadachar home"><span class="brand-mark" aria-hidden="true">s</span><span>sadachar</span></a>
            <div class="welcome-copy"><span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> WE’RE HERE TO HELP</span><h1 id="welcome-title">Learning feels better with <span>support.</span></h1><p>Your account helps keep your learning journey personal and secure.</p></div>
            <div class="help-art" aria-hidden="true"><div class="help-orbit"></div><div class="help-book">✦</div><div class="help-stem"></div><div class="help-leaf leaf-left"></div><div class="help-leaf leaf-right"></div><div class="help-ground"></div></div>
            <div class="welcome-footer"><span>Thoughtfully designed for every learner</span><span aria-hidden="true">·</span><span>Accessible by nature</span></div>
        </section>
        <section class="form-panel" aria-labelledby="help-heading">
            <div class="mobile-brand"><span class="brand-mark" aria-hidden="true">s</span><span>sadachar</span></div>
            <div class="auth-card help-card">
                <span class="help-icon" aria-hidden="true">?</span>
                <div class="form-heading"><span class="form-kicker">ACCOUNT SUPPORT</span><h2 id="help-heading">Need a hand?</h2><p>Password reset email isn’t set up for this application yet. Your account is safe; an institution administrator can help you regain access.</p></div>
                <a class="submit-button button-link" asp-action="Login"><span>Back to sign in</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg></a>
                <p class="auth-switch">Don’t have an account? <a asp-action="Register" class="text-link">Create one <span aria-hidden="true">→</span></a></p>
            </div>
            <footer class="form-footer"><a href="/" class="text-link">← Back to Sadachar</a><span>Made for learning without limits</span></footer>
        </section>
    </main>
</body>
</html>
