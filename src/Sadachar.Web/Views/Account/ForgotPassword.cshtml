@{
    Layout = "_Layout";
    ViewData["Title"] = "Password Help";
}

<div class="container-xl py-5">
    <div class="retro-card p-5 mx-auto text-center" style="max-width: 540px; background: var(--paper-card);">
        <div class="brush-blob brush-blob-mustard mb-4" style="width: 90px; height: 90px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
            <div style="width: 70px; height: 70px;">
                @await Html.PartialAsync("_Avatar", "Dot")
            </div>
        </div>
        <span class="pill-chip pill-chip-mustard mb-2">Account Support</span>
        <h1 class="font-headline fs-2 fw-black mb-3" style="color: var(--ink);">Need a <span class="retro-accent">hand?</span></h1>
        <p class="text-muted fw-semibold mb-4" style="font-size: 0.95rem; line-height: 1.6;">
            Password reset email delivery isn’t configured for this local environment. Your account is completely safe; use the pre-seeded accounts (<code>Access@123</code>) or contact your institutional administrator.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-action="Login" class="btn-retro-primary">
                <i class="bi bi-arrow-left me-1"></i> Back to sign in
            </a>
            <a asp-action="Register" class="btn-retro-secondary">
                Create new account
            </a>
        </div>
    </div>
</div>
