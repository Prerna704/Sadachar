@model Sadachar.Web.ViewModels.IssueKanbanViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Issue Tracking Board";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 fw-black mb-1 font-headline">Issue <span class="retro-accent">kanban</span></h1>
        <p class="text-muted mb-0 fw-semibold" style="font-size: 1rem;">Assign, prioritise and resolve digital and physical barriers</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Reports" class="btn-retro-secondary text-decoration-none">
            <i class="bi bi-file-earmark-bar-graph me-1" aria-hidden="true"></i> Audit reports
        </a>
    </div>
</div>

<!-- Three Column Kanban Board -->
<div class="row g-4">
    <!-- Column 1: Open -->
    <div class="col-lg-4">
        <div class="p-3" style="background: var(--paper-card); border: 3px solid var(--ink); border-radius: 16px; box-shadow: 6px 6px 0 var(--ink); min-height: 540px;">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 3px solid var(--ink);">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-black fs-5 font-headline">Open</span>
                    <span class="pill-chip pill-chip-coral py-0 px-2">@Model.OpenTickets.Count</span>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var ticket in Model.OpenTickets)
                {
                    <div class="retro-card p-3 mb-0" style="background: var(--paper-card);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-black font-headline" style="font-size: 0.85rem;">@ticket.TicketNumber</span>
                            <span class="pill-chip @(ticket.Priority == "High" ? "pill-chip-coral" : "pill-chip-mustard") py-0 px-2" style="font-size: 0.72rem;">
                                @ticket.Priority
                            </span>
                        </div>
                        <h2 class="h6 fw-bold mb-2 font-headline">@ticket.Subject</h2>
                        <p class="text-muted mb-3 fw-semibold" style="font-size: 0.85rem; line-height: 1.5;">
                            @(ticket.Description.Length > 80 ? ticket.Description.Substring(0, 80) + "..." : ticket.Description)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2" style="border-top: 2px solid var(--ink); font-size: 0.8rem;">
                            <span class="text-muted fw-bold">
                                <span class="badge bg-dark rounded-pill me-1">@ticket.AssigneeInitials</span> SLA @ticket.SlaDays d
                            </span>
                            <form asp-action="UpdateTicketStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                <input type="hidden" name="newStatus" value="In review" />
                                <button type="submit" class="btn-retro-secondary py-1 px-2" style="font-size: 0.75rem;" title="Move to In Review">
                                    Start &rarr;
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Column 2: In Review -->
    <div class="col-lg-4">
        <div class="p-3" style="background: var(--paper-card); border: 3px solid var(--ink); border-radius: 16px; box-shadow: 6px 6px 0 var(--ink); min-height: 540px;">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 3px solid var(--ink);">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-black fs-5 font-headline">In review</span>
                    <span class="pill-chip pill-chip-mustard py-0 px-2">@Model.InReviewTickets.Count</span>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var ticket in Model.InReviewTickets)
                {
                    <div class="retro-card p-3 mb-0" style="background: var(--paper-card);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-black font-headline" style="font-size: 0.85rem;">@ticket.TicketNumber</span>
                            <span class="pill-chip @(ticket.Priority == "High" ? "pill-chip-coral" : "pill-chip-mustard") py-0 px-2" style="font-size: 0.72rem;">
                                @ticket.Priority
                            </span>
                        </div>
                        <h2 class="h6 fw-bold mb-2 font-headline">@ticket.Subject</h2>
                        <p class="text-muted mb-3 fw-semibold" style="font-size: 0.85rem; line-height: 1.5;">
                            @(ticket.Description.Length > 80 ? ticket.Description.Substring(0, 80) + "..." : ticket.Description)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2" style="border-top: 2px solid var(--ink); font-size: 0.8rem;">
                            <span class="text-muted fw-bold">
                                <span class="badge bg-dark rounded-pill me-1">@ticket.AssigneeInitials</span> SLA @ticket.SlaDays d
                            </span>
                            <form asp-action="UpdateTicketStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                <input type="hidden" name="newStatus" value="Resolved" />
                                <button type="submit" class="btn-retro-primary py-1 px-2" style="font-size: 0.75rem;" title="Mark Resolved">
                                    Resolve &check;
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Column 3: Resolved -->
    <div class="col-lg-4">
        <div class="p-3" style="background: var(--paper-card); border: 3px solid var(--ink); border-radius: 16px; box-shadow: 6px 6px 0 var(--ink); min-height: 540px;">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 3px solid var(--ink);">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-black fs-5 font-headline">Resolved</span>
                    <span class="pill-chip pill-chip-teal py-0 px-2">@Model.ResolvedTickets.Count</span>
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var ticket in Model.ResolvedTickets)
                {
                    <div class="retro-card p-3 mb-0" style="background: var(--paper-card); opacity: 0.95;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-black font-headline" style="font-size: 0.85rem;">@ticket.TicketNumber</span>
                            <span class="pill-chip pill-chip-teal py-0 px-2" style="font-size: 0.72rem;">
                                Resolved
                            </span>
                        </div>
                        <h2 class="h6 fw-bold mb-2 font-headline" style="text-decoration: line-through;">@ticket.Subject</h2>
                        <p class="text-muted mb-3 fw-semibold" style="font-size: 0.85rem; line-height: 1.5;">
                            @(ticket.Description.Length > 80 ? ticket.Description.Substring(0, 80) + "..." : ticket.Description)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2" style="border-top: 2px solid var(--ink); font-size: 0.8rem;">
                            <span class="text-muted fw-bold">
                                Resolved by @ticket.AssigneeInitials
                            </span>
                            <span class="badge bg-success rounded-pill">&check; Closed</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
