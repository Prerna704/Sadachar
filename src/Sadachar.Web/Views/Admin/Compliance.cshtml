@model Sadachar.Web.ViewModels.ComplianceMonitoringViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Compliance Monitoring";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 fw-black mb-1 font-headline">Compliance <span class="retro-accent">monitoring</span></h1>
        <p class="text-muted mb-0 fw-semibold" style="font-size: 1rem;">Track alignment with accessibility standards, RPwD Act, and conduct policies</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Reports" class="btn-retro-secondary text-decoration-none">
            <i class="bi bi-file-earmark-bar-graph me-1" aria-hidden="true"></i> View reports
        </a>
    </div>
</div>

<!-- 3 Standard Score Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="retro-card h-100 p-4" style="background: var(--paper-card); border-left: 8px solid var(--teal);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-bold" style="font-size: 0.88rem;">WCAG 2.2 AA checks</span>
                <span class="pill-chip pill-chip-teal py-0 px-2" style="font-size: 0.72rem;">Certified</span>
            </div>
            <div class="display-4 fw-black mb-2 font-headline" style="color: var(--teal);">
                @Model.WcagScore%
            </div>
            <p class="text-muted fw-semibold mb-0" style="font-size: 0.82rem;">
                Evaluated against color contrast, alt-text, captions, keyboard navigability, and ARIA screen reader compatibility.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="retro-card h-100 p-4" style="background: var(--paper-card); border-left: 8px solid var(--mustard);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-bold" style="font-size: 0.88rem;">Institutional policy</span>
                <span class="pill-chip pill-chip-mustard py-0 px-2" style="font-size: 0.72rem;">Good</span>
            </div>
            <div class="display-4 fw-black mb-2 font-headline" style="color: var(--mustard);">
                @Model.InstitutionalPolicyScore%
            </div>
            <p class="text-muted fw-semibold mb-0" style="font-size: 0.82rem;">
                Adherence to physical barrier-free campus guidelines, ramp audits, and academic accommodation turnaround SLAs.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="retro-card h-100 p-4" style="background: var(--paper-card); border-left: 8px solid var(--coral);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-bold" style="font-size: 0.88rem;">Data protection (DPDP)</span>
                <span class="pill-chip pill-chip-coral py-0 px-2" style="font-size: 0.72rem;">Action needed</span>
            </div>
            <div class="display-4 fw-black mb-2 font-headline" style="color: var(--coral);">
                @Model.DataProtectionScore%
            </div>
            <p class="text-muted fw-semibold mb-0" style="font-size: 0.82rem;">
                Strict pseudonymization of sensitive disability data, retention time-limits, and confidential reporting protocols.
            </p>
        </div>
    </div>
</div>

<!-- Department Status Table -->
<div class="retro-card" style="background: var(--paper-card);">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2" style="border-bottom: 3px solid var(--ink);">
        <div>
            <h2 class="h5 fw-black mb-0 font-headline">Department status</h2>
            <small class="text-muted fw-semibold">Statutory accessibility rankings across university departments</small>
        </div>
        <button type="button" class="btn-retro-secondary py-1 px-3" onclick="alert('Running real-time campus crawler audit...');" style="font-size: 0.85rem;">
            <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Re-run audit
        </button>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" style="font-size: 0.95rem;">
            <thead>
                <tr style="border-bottom: 2.5px solid var(--ink);">
                    <th scope="col" class="fw-black font-headline">Department</th>
                    <th scope="col" class="fw-black font-headline">Score</th>
                    <th scope="col" class="fw-black font-headline">Last audit</th>
                    <th scope="col" class="fw-black font-headline">Flagged items</th>
                    <th scope="col" class="fw-black font-headline">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var audit in Model.DepartmentAudits)
                {
                    var chipVariant = audit.Status.ToLower() switch
                    {
                        "compliant" => "teal",
                        "action needed" => "mustard",
                        "at risk" => "coral",
                        _ => "sage"
                    };

                    <tr style="border-bottom: 1.5px solid var(--ink);">
                        <td>
                            <div class="fw-black font-headline">@audit.Department</div>
                            <small class="text-muted fw-semibold">Auditor: @audit.AuditorName</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold font-headline">@audit.Score%</span>
                                <div class="progress flex-grow-1" style="height: 8px; width: 60px; border: 1.5px solid var(--ink); border-radius: 9999px; background: #FFF;">
                                    <div class="progress-bar @(audit.Score >= 85 ? "bg-success" : audit.Score >= 80 ? "bg-warning" : "bg-danger")" style="width: @audit.Score%;"></div>
                                </div>
                            </div>
                        </td>
                        <td class="fw-semibold">@audit.AuditedOn.ToString("dd MMM")</td>
                        <td>
                            @if (audit.FlaggedItemsCount > 0)
                            {
                                <span class="pill-chip pill-chip-coral py-0 px-2" style="font-size: 0.75rem;">@audit.FlaggedItemsCount items</span>
                            }
                            else
                            {
                                <span class="pill-chip pill-chip-teal py-0 px-2" style="font-size: 0.75rem;">0 items</span>
                            }
                        </td>
                        <td>
                            <span class="pill-chip pill-chip-@chipVariant py-1 px-3">
                                @audit.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
